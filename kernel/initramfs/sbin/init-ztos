#!/bin/sh
# ztOS herolight Userspace Init
# Second-stage init after switch_root from initramfs
# This is the PID 1 of the running system

export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/ztos/bin
export LD_LIBRARY_PATH=/lib:/lib64:/usr/lib:/ztos/lib

# Source ztOS configuration
[ -r /etc/ztos/ztos.conf ] && . /etc/ztos/ztos.conf

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[ztOS-init]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[ztOS-init]${NC} $1"; }
log_error() { echo -e "${RED}[ztOS-init]${NC} $1"; }
log_step()  { echo -e "${BLUE}[ztOS-init]${NC} $1"; }

# Signal handlers
handle_signal() {
    log_warn "Received signal, shutting down..."
    /sbin/poweroff
}

trap handle_signal TERM INT

# Mount remaining filesystems
mount_filesystems() {
    log_step "Mounting filesystems..."
    
    mount -t proc none /proc
    mount -t sysfs none /sys
    mount -t devtmpfs none /dev
    mount -t tmpfs none /run
    mount -t tmpfs -o mode=1777 none /tmp
    mkdir -p /dev/pts
    mount -t devpts none /dev/pts
    
    # Mount persistent storage
    mkdir -p /var/log /var/tmp /var/run /var/lib
    mount -t tmpfs none /var/log
    mount -t tmpfs none /var/tmp
    mount -t tmpfs none /var/run
    
    log_info "Filesystems mounted"
}

# Network setup
setup_network() {
    log_step "Setting up network..."
    
    # Loopback
    ip link set lo up
    ip addr add 127.0.0.1/8 dev lo
    
    # USB RNDIS (if gadget was set up in initramfs)
    if [ -d /sys/class/net/usb0 ]; then
        ip link set usb0 up
        ip addr add 172.16.42.1/24 dev usb0
        
        # Start DHCP server for USB clients
        if command -v dnsmasq &> /dev/null; then
            dnsmasq --interface=usb0 --dhcp-range=172.16.42.10,172.16.42.50,255.255.255.0,12h \
                --dhcp-option=3,172.16.42.1 --dhcp-option=6,8.8.8.8 \
                --log-facility=/var/log/dnsmasq.log &
            log_info "USB DHCP server started (172.16.42.1)"
        fi
        
        # Enable IP forwarding for NAT
        echo 1 > /proc/sys/net/ipv4/ip_forward
        
        # NAT if we have another interface with internet
        for iface in wlan0 eth0; do
            if [ -d /sys/class/net/$iface ]; then
                iptables -t nat -A POSTROUTING -o $iface -j MASQUERADE 2>/dev/null || true
                log_info "NAT enabled for $iface"
                break
            fi
        done
    fi
    
    # Wi-Fi (if driver loaded)
    if [ -d /sys/class/net/wlan0 ]; then
        ip link set wlan0 up
        log_info "Wi-Fi interface wlan0 ready"
        
        # Start wpa_supplicant if config exists
        if [ -r /etc/wpa_supplicant.conf ]; then
            wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf 2>/dev/null || true
            log_info "wpa_supplicant started"
        fi
    fi
    
    log_info "Network ready"
}

# Samsung daemon setup
setup_samsung_daemons() {
    log_step "Setting up Samsung daemons..."
    
    # Create mount points for stock partitions
    mkdir -p /mnt/android/system /mnt/android/vendor
    
    # Mount stock SYSTEM read-only
    SYSTEM_PART=$(find_partition "SYSTEM")
    if [ -n "$SYSTEM_PART" ] && mount -t ext4 -o ro "$SYSTEM_PART" /mnt/android/system 2>/dev/null; then
        log_info "SYSTEM mounted for daemons"
    fi
    
    # Mount stock VENDOR read-only
    VENDOR_PART=$(find_partition "VENDOR")
    if [ -n "$VENDOR_PART" ] && mount -t ext4 -o ro "$VENDOR_PART" /mnt/android/vendor 2>/dev/null; then
        log_info "VENDOR mounted for daemons"
    fi
    
    # Bind mount Samsung binaries into expected paths
    mkdir -p /system/bin /vendor/lib
    mount --bind /mnt/android/system/bin /system/bin 2>/dev/null || true
    mount --bind /mnt/android/vendor/lib /vendor/lib 2>/dev/null || true
    
    # Sensor hub daemon (lhd)
    if [ -x /system/bin/lhd ]; then
        log_info "Starting lhd (sensor hub daemon)..."
        /system/bin/lhd &
        echo $! > /run/lhd.pid
    else
        log_warn "lhd not found - sensors may not work"
    fi
    
    # Modem daemon (cbd)
    if [ -x /system/bin/cbd ]; then
        log_info "Starting cbd (modem daemon)..."
        /system/bin/cbd -d -tss310 -bm -mm -P "$(find_partition RADIO)" &
        echo $! > /run/cbd.pid
    else
        log_warn "cbd not found - cellular may not work"
    fi
    
    # Wait for modem to initialize
    sleep 2
    
    # Check if rild (radio interface layer daemon) exists
    if [ -x /system/bin/rild ]; then
        log_info "Starting rild..."
        /system/bin/rild &
        echo $! > /run/rild.pid
    fi
}

# Hardware initialization
init_hardware() {
    log_step "Initializing hardware..."
    
    # Load kernel modules if any
    if [ -d /lib/modules ]; then
        for mod in /lib/modules/*.ko; do
            [ -f "$mod" ] || continue
            insmod "$mod" 2>/dev/null || true
        done
    fi
    
    # Set CPU governor
    if [ -d /sys/devices/system/cpu/cpufreq ]; then
        for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "$gov" ] && echo "schedutil" > "$gov" 2>/dev/null || true
        done
        log_info "CPU governor set to schedutil"
    fi
    
    # Set I/O scheduler
    for sched in /sys/block/*/queue/scheduler; do
        [ -w "$sched" ] && echo "mq-deadline" > "$sched" 2>/dev/null || true
    done
    
    # Set swappiness
    echo 60 > /proc/sys/vm/swappiness
    
    # Randomize MAC if needed (privacy)
    # echo 2 > /proc/sys/net/ipv4/conf/all/rp_filter
}

# First-boot setup
first_boot_setup() {
    if [ -f /etc/ztos/first-boot ]; then
        log_step "First boot detected, running setup..."
        
        # Generate SSH host keys
        if command -v ssh-keygen &> /dev/null; then
            mkdir -p /etc/ssh
            ssh-keygen -A 2>/dev/null || true
            log_info "SSH host keys generated"
        fi
        
        # Set hostname
        echo "ztos-herolight" > /etc/hostname
        hostname -F /etc/hostname
        
        # Create default user
        if command -v useradd &> /dev/null; then
            useradd -m -G wheel,audio,video,power alarm 2>/dev/null || true
            echo "alarm:alarm" | chpasswd 2>/dev/null || true
            log_info "Default user 'alarm' created (password: alarm)"
        fi
        
        # Mark first boot complete
        rm -f /etc/ztos/first-boot
        touch /etc/ztos/first-boot-complete
        log_info "First boot setup complete"
    fi
}

# Service supervisor
start_services() {
    log_step "Starting services..."
    
    # SSH daemon
    if command -v sshd &> /dev/null; then
        /usr/sbin/sshd &
        log_info "SSH daemon started"
    fi
    
    # Dropbear (lightweight SSH)
    if command -v dropbear &> /dev/null; then
        mkdir -p /etc/dropbear
        dropbear -R -B &
        log_info "Dropbear SSH started"
    fi
    
    # ADB daemon (for installer/debug)
    if command -v adbd &> /dev/null; then
        /usr/bin/adbd &
        log_info "ADB daemon started"
    fi
    
    # Bluetooth
    if [ -d /sys/class/bluetooth ]; then
        if command -v bluetoothd &> /dev/null; then
            bluetoothd &
            log_info "Bluetooth daemon started"
        fi
    fi
    
    # Audio
    if command -v pulseaudio &> /dev/null; then
        pulseaudio --system --daemonize 2>/dev/null || true
        log_info "PulseAudio started"
    fi
}

# Helper: find partition by name
find_partition() {
    local name="$1"
    local path="/dev/block/bootdevice/by-name/$name"
    [ -e "$path" ] && echo "$path"
}

# Main init sequence
main() {
    echo ""
    log_step "ztOS herolight Userspace Init"
    log_info "PID 1 starting..."
    echo ""
    
    mount_filesystems
    init_hardware
    setup_network
    setup_samsung_daemons
    first_boot_setup
    start_services
    
    log_step "System ready!"
    log_info "Login: alarm / alarm"
    log_info "USB SSH: ssh alarm@172.16.42.1"
    echo ""
    
    # Start getty on serial console
    if [ -c /dev/ttySAC0 ]; then
        /sbin/getty -L 115200 ttySAC0 vt100 &
    fi
    
    # Start getty on USB ACM if available
    if [ -c /dev/ttyGS0 ]; then
        /sbin/getty -L 115200 ttyGS0 vt100 &
    fi
    
    # Keep init running and handle reaping
    while true; do
        wait
        # Reap zombie processes
        while true; do
            set +e
            wait -n 2>/dev/null
            RET=$?
            set -e
            [ $RET -eq 127 ] && break
        done
        sleep 1
    done
}

# Run main
main
